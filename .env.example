# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).

# ── Discord: one bot per courtroom identity ──────────────────────────
# Create 4 applications at https://discord.com/developers/applications,
# invite each bot to your server, and put the bot tokens here.
DISCORD_TOKEN_FOREMAN=
DISCORD_TOKEN_JUROR_ONE=
DISCORD_TOKEN_JUROR_TWO=
DISCORD_TOKEN_JUROR_THREE=

# ── Jury brain: any OpenAI-compatible endpoint ───────────────────────
# Default setup used MiniMax M3 via an OpenAI-compatible gateway.
# config.json points at base_url + model; only the key lives here.
QWEN_API_KEY=

# ── Broadcast voices: ElevenLabs ─────────────────────────────────────
# Creator tier recommended for a full event (~10k chars per judged case).
# Voice IDs live in broadcast/elevenlabs_voices.json.
ELEVENLABS_API_KEY=

# ── Optional: local Foreman voice via a Hermes/OpenClaw instance ─────
# Legacy path from an earlier iteration; ElevenLabs replaced it.
# FOREMAN_HERMES_HOME=
# FOREMAN_VOICE=
