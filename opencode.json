{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode-go": {
      "npm": "@ai-sdk/anthropic",
      "name": "OpenCode Go",
      "env": ["QWEN_API_KEY"],
      "options": {
        "apiKey": "{env:QWEN_API_KEY}",
        "baseURL": "https://opencode.ai/zen/go/v1"
      },
      "models": {
        "minimax-m3": {
          "name": "MiniMax M3",
          "reasoning": true,
          "temperature": true,
          "tool_call": true
        }
      }
    }
  },
  "permission": {
    "edit": "deny",
    "bash": "deny",
    "write": "deny",
    "read": "deny",
    "glob": "deny",
    "grep": "deny",
    "list": "deny",
    "external_directory": "deny",
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "lsp": "deny",
    "skill": "deny",
    "question": "deny",
    "todowrite": "deny"
  }
}
